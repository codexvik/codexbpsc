# Copy this file to .env.local (gitignored, never committed) and fill in real values.
# .env.local is loaded automatically by notifications/telegram_bot.py and by api/main.py.

TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Turns on the /admin console (api/admin.py) -- opt-in, local dev only.
# Never set this on a public deployment (Render etc.) -- admin.py has no
# auth yet. See api/main.py's ADMIN_ENABLED gate.
ADMIN_ENABLED=true

# Leave unset to use the local Postgres default (dbname=codexbpsc, peer
# auth). Point this at a shared cloud Postgres connection string instead
# once one exists, so local admin/scheduler and the public deployment read
# the same data.
# DATABASE_URL=
